procedure main() returns integer {
  var integer x = 0;
  var real y = 0;
  var real z = 0;
  tuple(integer, real) tup = (1, 2.0);
  x, y = tup;
  z, y = tup;
  z, y = (y, z);
  x -> std_output; '\n' -> std_output;
  y -> std_output; '\n' -> std_output;
  z -> std_output; '\n' -> std_output;
  var integer a = 1; var integer b = 2;
  a, b = (b, a);
  a -> std_output; b -> std_output; '\n' -> std_output;
  var integer p = 0; var tuple(integer, integer) q = (0, 0);
  p, q = (1, (2, 3));
  p -> std_output; q.1 -> std_output; q.2 -> std_output; '\n' -> std_output;
  var integer s1; var integer s2; var integer s3;
  var tuple(integer, integer, integer) tr = (7, 8, 9);
  s1, s2, s3 = tr;
  s1 -> std_output; s2 -> std_output; s3 -> std_output; '\n' -> std_output;
  return 0;
}
