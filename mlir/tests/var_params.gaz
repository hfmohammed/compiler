procedure swap(var integer a, var integer b) { var integer t = a; a = b; b = t; }
procedure inc(var integer x) { x = x + 1; }
procedure setpair(var tuple(integer, real) p) { p.1 = 9; p.2 = 0.5; }
procedure both(var integer a, var integer b) { a = 1; b = 2; }
procedure rd(const integer a, var integer b) { b = a * 2; }
procedure bump(var integer a) returns integer { a = a + 1; return a; }
procedure main() returns integer {
  var integer x = 1; var integer y = 2;
  call swap(x, y);
  x -> std_output; y -> std_output; '\n' -> std_output;
  call inc(x); call inc(x);
  x -> std_output; '\n' -> std_output;
  var tp = (0, 0.0);
  call setpair(tp);
  tp.1 -> std_output; ' ' -> std_output; tp.2 -> std_output; '\n' -> std_output;
  var t2 = (0, 0);
  call both(t2.1, t2.2);
  t2.1 -> std_output; t2.2 -> std_output; '\n' -> std_output;
  call rd(x, y);
  y -> std_output; '\n' -> std_output;
  call rd(5, y);
  y -> std_output; '\n' -> std_output;
  var r = bump(x);
  r -> std_output; ' ' -> std_output; x -> std_output; '\n' -> std_output;
  return 0;
}
