procedure main() returns integer {
  var integer m = -2147483647 - 1;
  (m / -1) -> std_output; '\n' -> std_output;
  (m % -1) -> std_output; '\n' -> std_output;
  (7 % -1) -> std_output; '\n' -> std_output;
  (2 ^ (0 - 1)) -> std_output; '\n' -> std_output;
  (1 ^ (0 - 5)) -> std_output; '\n' -> std_output;
  ((-1) ^ (0 - 3)) -> std_output; '\n' -> std_output;
  ((-1) ^ (0 - 4)) -> std_output; '\n' -> std_output;
  return 0;
}
