procedure main() returns integer {
  tuple(integer, real) t = (1, 2.5);
  t.1 -> std_output; ' ' -> std_output; t.2 -> std_output; '\n' -> std_output;
  var tuple(integer, character) v = (7, 'x');
  v.1 = v.1 + 1; v.2 = 'y';
  v.1 -> std_output; v.2 -> std_output; '\n' -> std_output;
  var tuple(real, real) w = (1, 2);
  w.1 = 3;
  w.1 -> std_output; ' ' -> std_output; w.2 -> std_output; '\n' -> std_output;
  return 0;
}
