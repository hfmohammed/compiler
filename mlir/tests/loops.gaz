procedure main() returns integer {
  var integer i = 0;
  loop while (i < 3) { i -> std_output; i = i + 1; }
  '\n' -> std_output;
  loop while (false) { 'X' -> std_output; }
  i = 10;
  loop { i -> std_output; i = i + 1; } while (i < 10);
  '\n' -> std_output;
  i = 0;
  loop { if (i == 4) { break; } i -> std_output; i = i + 1; }
  '\n' -> std_output;
  i = 0;
  loop { i = i + 1; if (i % 2 == 0) { continue; } i -> std_output; if (i > 6) break; }
  '\n' -> std_output;
  i = 0;
  loop i = i + 1; while (i < 5);
  i -> std_output; '\n' -> std_output;
  return 0;
}
