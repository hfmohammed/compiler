procedure main() returns integer {
  (1, 2) == (1, 2) -> std_output; '\n' -> std_output;
  (1, 2) != (1, 2) -> std_output; '\n' -> std_output;
  (1, 2) == (2, 1) -> std_output; '\n' -> std_output;
  (1, 2) != (2, 1) -> std_output; '\n' -> std_output;
  (1.0, 2) == (1, 2.0) -> std_output; '\n' -> std_output;
  var a = (1, 'x'); var b = (1, 'x');
  (a == b) -> std_output; '\n' -> std_output;
  b.2 = 'y';
  (a == b) -> std_output; '\n' -> std_output;
  (a != b) -> std_output; '\n' -> std_output;
  ((1, (2, 3)) == (1, (2, 3))) -> std_output; '\n' -> std_output;
  ((1, (2, 3)) == (1, (2, 4))) -> std_output; '\n' -> std_output;
  var c = 1; var d = 2;
  if ((c, d) == (1, 2)) { 'y' -> std_output; } else { 'n' -> std_output; }
  '\n' -> std_output;
  return 0;
}
