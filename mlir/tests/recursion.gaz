function fact(integer n) returns integer {
  if (n <= 1) { return 1; }
  return n * fact(n - 1);
}
function gcd(integer a, integer b) returns integer {
  if (b == 0) { return a; }
  return gcd(b, a % b);
}
function isOdd(integer n) returns boolean {
  if (n == 0) { return false; }
  return isEven(n - 1);
}
function isEven(integer n) returns boolean {
  if (n == 0) { return true; }
  return isOdd(n - 1);
}
function ack(integer m, integer n) returns integer {
  if (m == 0) { return n + 1; }
  if (n == 0) { return ack(m - 1, 1); }
  return ack(m - 1, ack(m, n - 1));
}
procedure main() returns integer {
  fact(10) -> std_output; '\n' -> std_output;
  gcd(1071, 462) -> std_output; '\n' -> std_output;
  isEven(10) -> std_output; isOdd(7) -> std_output; isEven(7) -> std_output; '\n' -> std_output;
  ack(2, 3) -> std_output; '\n' -> std_output;
  return 0;
}
