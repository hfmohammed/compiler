procedure bump(integer x) returns integer {
  return x + 1;
}

procedure main() returns integer {
  var x = 1;
  {
    var integer x = 10;
    bump(x) -> std_output;
    '\n' -> std_output;
  }
  loop while (x < 4) { x = bump(x); }
  x -> std_output;
  '\n' -> std_output;
  call bump(x);
  return x;
}
